###############################################################################
# FLOP Technocore Close Call — orchestrator configuration
#
# Copy to `.env` and fill in. Everything here is read once at startup, validated
# by zod, and then frozen; a bad value is a startup error, never a silent default.
#
# The two rules that matter most:
#   - FLOP_MODE defaults to dry-run, and live trading needs FLOP_MODE=live,
#     FLOP_LIVE_CONFIRM=close-1, FLOP_ALLOW_REGISTRATION=true and a pinned
#     EXPECTED_REFEREE_DID. No single variable can arm it, and the process
#     refuses to start half-armed.
#   - every throttling knob is bounded, because this runs on a shared 2 vCPU box.
#
# On the VPS, every path below that holds state (data, secrets, logs, archive)
# must be absolute and OUTSIDE the release directory, so a rollback moves code
# and nothing else. See "Deploying on the VPS" in the README.
###############################################################################

# ---- process -----------------------------------------------------------------
NODE_ENV=production
TIMEZONE=Asia/Shanghai
LOG_LEVEL=info
DATA_DIR=data
SECRETS_DIR=secrets
RELEASES_DIR=releases
# VPS layout (uncomment and use these instead of the relative defaults above).
# Logs go to the journal — `StandardOutput=journal` in the unit — so there is no
# log directory to configure.
#   DATA_DIR=/opt/flop-close-call/shared/data
#   SECRETS_DIR=/opt/flop-close-call/secrets

# ---- profile -----------------------------------------------------------------
# lite | full. `lite` is the deployable contest profile: one process, the fixed
# six rooms, no model lane on the trade path. MAX_DISCOVERED_ROOMS is forced to
# 0 under `lite` (the fixed referee set and close1 are always read).
FLOP_PROFILE=lite

# ---- mode --------------------------------------------------------------------
# dry-run | live
FLOP_MODE=dry-run
# must equal the contest id for live trading to arm
FLOP_LIVE_CONFIRM=
# explicit gate for posting owner registrations to technocore
# live REQUIRES this to be true: 150 unregistered agents would trade on
# accounts the referee never minted.
FLOP_ALLOW_REGISTRATION=false
# explicit gate for signing and posting trades, separate from registration.
# Run live+registration with this false until all 150 readbacks are in, then
# turn it on as a deliberate second step.
FLOP_ALLOW_TRADING=false

# ---- late-start full participation ------------------------------------------
# Participate in close-1 when the opening seed has already rotated out of
# `d-close1-price`'s retained ring. The seed is a one-time post, so a process
# that starts late can never read it; this mode replaces that one requirement
# with a different anchor: the pinned referee's *current*, signed price post.
#
# It is off by default, cannot be armed by FLOP_MODE=live alone, and never
# relaxes the trust boundary. It still requires a non-empty EXPECTED_REFEREE_DID
# and EXPECTED_PACKAGE_HASH, still refuses `adopt_first_sender`, and still
# verifies every room-bound signature. What it drops is only the demand that the
# history be replayed from the seed — never the demand that a post be genuine.
#
# Armed only when LATE_START_CONFIRM is exactly `close-1-late-start`. If any
# confirmation is missing the process keeps running as a dry run and `/status`
# reports `lateStartBlockedReason`. A half-configured late start never posts an
# owner registration or a trade.
LATE_START_MODE=false
LATE_START_CONFIRM=
# Trading in a late start needs BOTH this and FLOP_ALLOW_TRADING: arming the
# mode must never be enough on its own to write a trade.
LATE_START_ALLOW_TRADING=false
#
# Staged rollout, in order, one step at a time:
#   1. dry run    : FLOP_MODE=dry-run, LATE_START_MODE=false
#                   -> prove 150 unique DIDs, 6 rooms readable, a current price
#                      post from the pinned referee, and the package pin set.
#   2. register   : FLOP_MODE=live FLOP_LIVE_CONFIRM=close-1 LATE_START_MODE=true
#                   LATE_START_CONFIRM=close-1-late-start
#                   FLOP_ALLOW_REGISTRATION=true FLOP_ALLOW_TRADING=false
#                   -> post the 150 owner registrations, then wait for the room
#                      echo of each and for the next price/flow sweep.
#   3. trade      : FLOP_ALLOW_TRADING=true LATE_START_ALLOW_TRADING=true
#                   -> only once the registrations have a POST/echo record and
#                      the writer, the nonce store and the price post are healthy.
# The process never moves between these steps on its own, and never past the
# lock: after `lock_sweep` no registration and no trade is written.

# ---- close call --------------------------------------------------------------
SEASON=close-1
TRADING_ROOM=close1
CONTEST_JSON_PATH=reference/contest.json
# the vendored official package the rules and the package pin come from
REFERENCE_DIR=reference
# the sha256 of reference/manifest.json the launch record pins. Empty means
# "use the vendored manifest's own sha256", which is the default and is
# cross-checked against the bundle at every startup.
EXPECTED_PACKAGE_HASH=
# the referee's DID, fixed before the first message is read. live REQUIRES it:
# without a pin, the first signed post decides who the referee is.
EXPECTED_REFEREE_DID=
# refuse to infer the referee from whoever posts first. Keep true.
REQUIRE_REFEREE_PIN=true
# a file holding the official signed seed envelope, for a process that starts
# after the seed has left `d-close1-price`'s retained ring. Empty means "the
# referee rooms alone must supply the seed". When set, the envelope is verified
# by the same verifier a live seed goes through — room-bound signature, sender
# DID against EXPECTED_REFEREE_DID, seed schema, season, package hash against
# the pin, and the seed room — and nothing weaker is accepted: not a bare seed
# payload, not an unsigned JSON blob, not a hand-written opening price and not a
# package hash on its own. A bootstrap that does not verify is a warning and
# changes no gate.
REFEREE_SEED_BOOTSTRAP_PATH=
# the season is 150 agents in five groups of thirty
EXPECTED_AGENT_COUNT=150
REQUIRE_FULL_FLEET=true

# ---- age identity ------------------------------------------------------------
# Path to the runtime recovery key. It decrypts secrets/agents.bundle.age; the
# decrypted seeds live in process memory only and are never written to disk.
# chmod 600 this file and chmod 700 the secrets directory.
AGE_IDENTITY_FILE=secrets/runtime.key
# Two recipients: the VPS runtime key and the offline admin key. Both are public
# keys (age1...), safe to keep here. The admin key is encrypted to the admin
# recipient ONLY, so taking the VPS does not yield an inventory signer.
AGE_RECIPIENT_VPS=
AGE_RECIPIENT_ADMIN=
# The admin key's public half, so this host can verify the inventory signature
# without ever holding the private key. Same value as secrets/admin-public.key.
ADMIN_PUBLIC_KEY=

# ---- technocore --------------------------------------------------------------
TECHNO_CORE_BASE_URL=https://technocore.chat
# Reader concurrency and pacing.
#
# The six fixed rooms are read by the reader's OWN continuous loops, decoupled
# from the agent scheduler and from TICK_SECONDS. Under the lite profile the
# default is one read slot per fixed room (6); an explicit value here always
# wins, and MAX_INFLIGHT below stays the hard cap on real HTTP requests.
READ_CONCURRENCY=6
# Long-poll hold, seconds. Each room's loop re-reads the moment its previous
# read returns, so the wait is the pacing, not a sleep between reads.
READ_WAIT_SECONDS=10
# Whether the reader's continuous loops own the fixed rooms. On by default: a
# room that grows faster than one `limit`-sized page per scheduler tick would
# otherwise be read with a gap on every page boundary. Off falls back to the
# scheduler driving tick(), which is what a unit test wants.
READER_ENABLED=true
# How long a room loop waits after a FAILED read before retrying. A successful
# read never waits.
READER_RETRY_DELAY_MS=2000
WRITE_RATE_PER_MINUTE=180
WRITER_CONCURRENCY=1
REQUEST_TIMEOUT_MS=15000
READ_MAX_RETRIES=3
WRITE_MAX_RETRIES=4
# Hard cap on requests in flight across the whole process, including the six
# fixed-room long polls and the bounded dynamic-room pass.
MAX_INFLIGHT=6
# ---- page size and catch-up --------------------------------------------------
# The largest `limit` the read endpoint accepts. 200 is the documented ceiling and
# the number the live service enforces: a larger `limit` is refused rather than
# truncated, so raising this without the service's own confirmation would turn
# every read into a 400. Everything below is clamped to it, and the client refuses
# to put anything larger on the wire.
TECHNOCORE_SERVER_LIMIT=200
# Messages per read for a room without its own limit (the five referee rooms).
READ_LIMIT=200
# Messages per read for the trading room (TRADING_ROOM, close1). Its own knob
# because it is the one room that grows faster than a scheduler tick.
CLOSE1_READ_LIMIT=200
# The trading room's page size while it is behind. Only meaningful when
# TECHNOCORE_SERVER_LIMIT is above CLOSE1_READ_LIMIT; otherwise it is clamped back.
CLOSE1_CATCHUP_LIMIT=200
# The most reads per second a room in catch-up may issue. A room that is behind
# reads back to back, and without a cap one saturated room would spend the whole
# MAX_INFLIGHT budget and starve the referee rooms. 0 leaves it uncapped.
CLOSE1_CATCHUP_MAX_REQUESTS_PER_SECOND=0
# How long a room may keep being called `catching_up` before the reader stops
# calling it a temporary state. 0 leaves it unbounded (the two-consecutive-window
# rule still applies).
CLOSE1_CATCHUP_MAX_SECONDS=900
# How long a fixed room may go unread before a `reader_fairness_warning` is
# recorded. A busy room must never starve the rest of the fixed set.
READER_FAIRNESS_MAX_SILENCE_MS=120000

# ---- read coverage: what a `close1` gap does, and how recovery may work ------
# `degraded_readonly` (the dry-run default) keeps reading, reporting and
# registration alive while trading stays refused — it is observation only, and
# it never lets the room be described as fully covered. `block` is stricter:
# it refuses registration and trading on any recorded gap in the trading room,
# exactly as the five referee rooms do. Neither value can wave through a gap
# that might hold one of our own owner registrations, trades or re-posts.
CLOSE1_GAP_POLICY=degraded_readonly
# The operator switch for a registration-only launch over a room with a *plain
# public* coverage gap. Off everywhere by default, in dry-run and in live alike.
# It covers a historical band that provably holds nothing of ours and nothing
# else: a band that could hold one of our own registrations is refused whichever
# way this is set, and it never permits a trade. Every live registration made
# under it is reported as degraded coverage with trading still blocked.
ALLOW_REGISTRATION_WITH_CLOSE1_GAP=false
# The operator switch for trading over a plain public coverage gap. It is
# deliberately not sufficient on its own: even with it set the trade stays
# blocked unless a recorded override names the operator, the reason and the time,
# because a config value with no author is not a decision anybody can be held to.
# Leave this off; the default is to block.
ALLOW_TRADING_WITH_CLOSE1_GAP=false
# The recorded manual override `ALLOW_TRADING_WITH_CLOSE1_GAP` requires to mean
# anything. Both must be set for the override to exist at all — half a record is
# not a decision, and the gate treats it as absent.
TRADING_OVERRIDE_OPERATOR=
TRADING_OVERRIDE_REASON=
# Export-assisted recovery after a recorded gap. GET /r/<room>/export is a
# snapshot of the *retained ring*, not a replay: it can pull a backlog in one
# round trip, and it can never bring back a range the ring already dropped.
EXPORT_RECOVERY_ENABLED=false
EXPORT_RECOVERY_MAX_BYTES=12582912
EXPORT_RECOVERY_TIMEOUT_MS=20000
# Minimum interval between export attempts for the same room. A gap that repeats
# on every poll is one fact, not a stream of them; without this a permanently
# gapping room would export on every read.
EXPORT_RECOVERY_COOLDOWN_MS=60000

# ---- deepseek ----------------------------------------------------------------
# Low-frequency strategy-parameter review only. Never called per agent, never
# called per sweep, never called outside the idle windows. OFF by default: the
# MVP does not depend on it, every strategy has a deterministic fallback, and a
# model failure never touches the trade path. Turn it on deliberately.
DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_NORMAL_CALLS_PER_DAY=2
DEEPSEEK_MAX_RETRIES_PER_DAY=1
DEEPSEEK_HARD_LIMIT_PER_DAY=3
DEEPSEEK_MAX_CONCURRENCY=1
DEEPSEEK_MIN_INTERVAL_MS=1500
DEEPSEEK_TIMEOUT_MS=20000
DEEPSEEK_MAX_INPUT_TOKENS=900
DEEPSEEK_MAX_OUTPUT_TOKENS=160

# ---- lark --------------------------------------------------------------------
# Outbound reports and alerts always go through the Open API, which needs only
# LARK_APP_ID / LARK_APP_SECRET / LARK_CHAT_ID. `websocket` additionally opens
# the optional inbound status channel and is the only mode that uses LARK_BOT_ID.
LARK_MODE=open-api
LARK_WS_ENABLED=false
LARK_TIMEZONE=Asia/Shanghai
LARK_APP_ID=
LARK_APP_SECRET=
# used by the WebSocket mode only; leave empty for Open API reports
LARK_BOT_ID=
LARK_CHAT_ID=
LARK_REPORT_TIMES=08:50,18:10
LARK_RECONNECT_MIN_MS=1000
LARK_RECONNECT_MAX_MS=60000
# How long a connected socket may go without a pong before the health report
# calls the heartbeat stale. The server decides the ping interval, so this is a
# generous "gone quiet" alarm, not a timer. It never forces a reconnect.
LARK_HEARTBEAT_TIMEOUT_MS=300000

# ---- concurrency -------------------------------------------------------------
LLM_CONCURRENCY=1
LARK_WS_CONNECTIONS=1
ARCHIVE_WORKERS=1

# ---- scheduling --------------------------------------------------------------
# The AGENT cadence: strategy evaluation, registration, trading, reports,
# watchdog, metrics. It is NOT the reader's cadence — the six fixed rooms are
# read by the reader's own continuous loops (see READER_ENABLED above), so a
# busy room is drained between ticks rather than once per tick.
TICK_SECONDS=60
AGENTS_PER_TICK=10
RUN_WINDOW_HOURS=168
WEEKLY_WATCHDOG_CRON_HOURS=6

# ---- upstream monitor --------------------------------------------------------
# Watches the official repo every 10-15 minutes and NEVER applies anything.
UPSTREAM_CHECK_MINUTES=12
UPSTREAM_REPO=flop-labs/technocore-close-call-challenge
UPSTREAM_BRANCH=main
UPSTREAM_GITHUB_TOKEN=

# ---- stale reference ---------------------------------------------------------
# The referee's own `age_s` for the price it last posted. The official reference
# is never rewritten when it goes stale — crossing this only stops new risk.
MAX_REFERENCE_AGE_SECONDS=60
# `no_new_active_trade` refuses new maker offers and external offers while stale.
# `off` disables the signal (useful for dry runs against a quiet room).
STALE_REFERENCE_MODE=no_new_active_trade

# ---- external offers ---------------------------------------------------------
# The one path where a number we did not choose becomes our position, so it gets
# its own ceilings on top of the local risk caps. OFF by default: taking external
# offers needs a validated dynamic-room read, and until that has passed real
# staging the process stays on `roomScope=close1_only`.
EXTERNAL_OFFER_TAKER_ENABLED=false
MAX_EXTERNAL_OFFER_QTY=15
MAX_EXTERNAL_OFFER_NOTIONAL=4500
# Kept on top of the worst-case fee: the close is unknown when we countersign.
MAX_CLAWBACK_BUFFER=50

# ---- rooms -------------------------------------------------------------------
# Cap on *discovered* owner rooms. The six rooms we read unconditionally (the five
# referee rooms and close1) are never subject to it, and close1 is never dropped.
# Beyond the cap the reader records room_overflow and alerts rather than opening
# more long polls.
MAX_DISCOVERED_ROOMS=10
# How many discovered owner rooms are read at once. Deliberately its own, low
# budget so a discovered room never queues behind the fixed referee feed.
DYNAMIC_ROOM_READ_CONCURRENCY=1

# ---- challenge sweep archive -------------------------------------------------
# An auxiliary audit source, polled on its own timer. It never overrides a
# verified referee message, and a missing record is a data gap, not a failure.
# The public archive is thousands of sweeps, so every check is budgeted: a bounded
# batch, a byte ceiling, and a minimum spacing between requests. A record is only
# skipped once its index entry is unchanged; if any of status/path/sha256/size
# moves, it is downloaded and re-verified.
CHALLENGE_ARCHIVE_BASE_URL=https://challenges.technocore.chat/close-1
ARCHIVE_CHECK_INTERVAL_MINUTES=15
ARCHIVE_MAX_RECORDS_PER_CHECK=10
ARCHIVE_MAX_BYTES_PER_CHECK=100000000
ARCHIVE_MAX_REQUESTS_PER_MINUTE=10
ARCHIVE_BACKFILL_MODE=oldest_first

# ---- staging acceptance ------------------------------------------------------
# Opt-in switch for the real-network staging smoke test (tests/staging-smoke.test.ts).
# Left false, every staging test is skipped. Live trading is never claimed to be
# allowed until a real Technocore staging run has been completed by a human.
STAGING_SMOKE_TEST=false

# ---- health ------------------------------------------------------------------
HEALTH_PORT=8780
HEALTH_HOST=127.0.0.1

# ---- load guard --------------------------------------------------------------
# Strictly increasing. See README for what each tier pauses.
RSS_PAUSE_PERCENT=70
RSS_SHED_PERCENT=85
EVENT_LOOP_LAG_MS=250
EVENT_LOOP_LAG_SECONDS=60
DISK_COMPRESS_PERCENT=75
DISK_SHED_PERCENT=85
DISK_CRITICAL_PERCENT=90
DISK_READONLY_PERCENT=95
WRITER_QUEUE_SHED=100
LLM_QUEUE_SHED=5

# ---- node --------------------------------------------------------------------
NODE_OPTIONS=--max-old-space-size=512
