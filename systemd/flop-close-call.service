[Unit]
Description=FLOP Technocore Close Call orchestrator (contest close-1)
Documentation=https://github.com/flop-labs/technocore-close-call-challenge
# Only start once the network and the filesystem holding /opt are up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flop
Group=flop
WorkingDirectory=/opt/flop-close-call/current

# The working directory is a symlink to a release; loading `.env` from it means a
# rollback is a symlink move plus a restart, no config edit.
EnvironmentFile=/opt/flop-close-call/current/.env

# PM2 is deliberately NOT used here: systemd is the supervisor, so there is one
# cgroup with one process, and the resource ceilings below are enforced by the
# kernel rather than promised by a config file.
ExecStart=/usr/bin/node --max-old-space-size=512 /opt/flop-close-call/current/dist/main.mjs
Restart=always
RestartSec=5s
# A crash loop must not spin on a shared box.
StartLimitIntervalSec=300
StartLimitBurst=10
# Give an in-flight room write time to finish before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30s

# ---- resource ceilings (2 vCPU / 4 GB VPS, shared with other tenants) --------
# 75% of one core; MemoryHigh is a soft throttle, MemoryMax is the hard wall that
# the process must never reach (PM2's restart line sits at 650M, below both).
CPUQuota=75%
MemoryHigh=640M
MemoryMax=768M
# 128 tasks is generous for one Node process with a handful of helper threads and
# is a hard stop on a thread leak.
TasksMax=128
LimitNOFILE=512
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# ---- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Only the release tree, the data directory and the secrets directory are writable.
ReadWritePaths=/opt/flop-close-call/current/data /opt/flop-close-call/current/secrets /opt/flop-close-call/current/logs
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# Node needs a few syscalls that a stricter sandbox blocks; keep the default set
# plus the ones the runtime actually uses.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ---- logging -----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flop-close-call

[Install]
WantedBy=multi-user.target
