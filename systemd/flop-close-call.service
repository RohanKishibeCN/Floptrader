[Unit]
Description=FLOP Technocore Close Call orchestrator (contest close-1)
Documentation=https://github.com/flop-labs/technocore-close-call-challenge
# Only start once the network and the filesystem holding /opt are up.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=flop
Group=flop
# `current` is a symlink to a release. Only code lives there.
WorkingDirectory=/opt/flop-close-call/current

# The environment file lives OUTSIDE the release. Loading it from `current/`
# would make a rollback swap the configuration — and the paths in it — at the
# same moment as the code, which is exactly the thing a rollback must not do.
EnvironmentFile=/opt/flop-close-call/shared/flop.env

# PM2 is deliberately NOT used here: systemd is the supervisor, so there is one
# cgroup with one process, and the resource ceilings below are enforced by the
# kernel rather than promised by a config file. `ecosystem.config.cjs` exists for
# development only.
ExecStart=/usr/bin/node --max-old-space-size=512 /opt/flop-close-call/current/dist/main.mjs
Restart=always
RestartSec=5s
# A crash loop must not spin on a shared box.
StartLimitIntervalSec=300
StartLimitBurst=10
# Give an in-flight room write time to finish before SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=30s

# ---- resource ceilings (2 vCPU / 4 GB VPS, shared with other tenants) --------
# 75% of one core; MemoryHigh is a soft throttle, MemoryMax is the hard wall that
# the process must never reach.
CPUQuota=75%
MemoryHigh=640M
MemoryMax=768M
# 128 tasks is generous for one Node process with a handful of helper threads and
# is a hard stop on a thread leak.
TasksMax=128
LimitNOFILE=512
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# ---- hardening ---------------------------------------------------------------
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
# Only the shared state tree and the secrets directory are writable — the
# release tree stays read-only, so a compromised process cannot rewrite its own
# code or survive a rollback. `shared` holds the database, the archive, the
# backups and the logs; `secrets` holds the encrypted bundle and the runtime key.
ReadWritePaths=/opt/flop-close-call/shared /opt/flop-close-call/secrets
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
# Node needs a few syscalls that a stricter sandbox blocks; keep the default set
# plus the ones the runtime actually uses.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# ---- logging -----------------------------------------------------------------
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flop-close-call

[Install]
WantedBy=multi-user.target
